# ==============================================================================
# MediSlot - Environment Configuration Template
# Smart Healthcare Appointment & Patient Care Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Local or Neon / Supabase / AWS RDS).
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medislot?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE & BACKGROUND QUEUES (Redis / Upstash)
# ------------------------------------------------------------------------------
# Redis connection URL for BullMQ job queue (email notifications, reminders).
# Format: redis://[host]:[port] or rediss://default:[password]@[host]:[port]
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Strong secret key used to sign and verify JWT authentication tokens.
# Generate a secure 32+ character random string in production.
AUTH_SECRET="medislot-super-secret-jwt-key-change-in-production-2026"

# Backend server listening port (Default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key for pre-visit symptom analysis and doctor preparation.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key for appointment confirmations, reminders, and notifications.
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# Sender address shown on transactional emails.
EMAIL_FROM="MediSlot <notifications@medislot.demo>"

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR 2-WAY SYNC (Google Cloud OAuth 2.0)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create a project and enable the "Google Calendar API"
# 2. Configure OAuth Consent Screen
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized Redirect URI to: http://localhost:3001/calendar/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/calendar/callback"

# ------------------------------------------------------------------------------
# 7. FRONTEND INTEGRATION (Next.js)
# ------------------------------------------------------------------------------
# Base URL for the MediSlot API. In development, defaults to http://localhost:3001.
# In production, set to your deployed backend URL (e.g., https://api.medislot.com).
NEXT_PUBLIC_API_URL="http://localhost:3001"
