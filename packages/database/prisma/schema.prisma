generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUIRED
  NO_SHOW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  patientProfile     PatientProfile?
  doctorProfile      DoctorProfile?
  calendarConnection CalendarConnection?
  
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model PatientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  specialisation String
  workingDays    Int[]    // e.g., [1, 2, 3, 4, 5] for Mon-Fri
  workingHours   Json     // e.g., {"start": "09:00", "end": "17:00"}
  slotDuration   Int      // in minutes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  leaves         DoctorLeave[]
  appointments   Appointment[]
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // Ensures time component is 00:00:00
  createdAt DateTime @default(now())
  
  @@unique([doctorId, date])
}

model Appointment {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(HELD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  doctor    DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  
  symptoms       SymptomSubmission?
  preVisit       PreVisitSummary?
  visit          Visit?
  events         CalendarEvent[]
  notifications  Notification[]
  
  // CRITICAL: Double-booking prevention
  @@unique([doctorId, startTime])
}

model SymptomSubmission {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rawSymptoms   String
  submittedAt   DateTime    @default(now())
}

model PreVisitSummary {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  urgencyLevel   UrgencyLevel
  chiefComplaint String
  questions      String[]
  status         JobStatus   @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Visit {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinicalNotes String
  followUpSteps String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  prescriptions Prescription[]
  postVisit     PostVisitSummary?
}

model PostVisitSummary {
  id            String    @id @default(uuid())
  visitId       String    @unique
  visit         Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  summaryText   String
  safetyNote    String?
  status        JobStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Prescription {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  medications PrescriptionMedication[]
}

model PrescriptionMedication {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  name           String
  dose           String
  frequency      String
  duration       String
  
  reminders      MedicationReminder[]
}

model MedicationReminder {
  id             String                 @id @default(uuid())
  medicationId   String
  medication     PrescriptionMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  reminderTime   DateTime
  status         JobStatus              @default(PENDING)
  
  @@unique([medicationId, reminderTime])
}

model CalendarEvent {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  providerEventId String
  provider      String      // "google"
  ownerId       String      // user ID (patient or doctor)
  status        JobStatus   @default(COMPLETED)
  
  @@unique([appointmentId, ownerId])
}

model Notification {
  id            String      @id @default(uuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  userId        String
  type          String      // BOOKING_CONFIRMATION, APPOINTMENT_REMINDER, etc.
  status        JobStatus   @default(PENDING)
  deliveryMethod String     // EMAIL
  createdAt     DateTime    @default(now())
}

model OutboxEvent {
  id        String   @id @default(uuid())
  type      String   // NOTIFICATION, LLM_PRE_VISIT, LLM_POST_VISIT, CALENDAR_SYNC
  payload   Json
  status    JobStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // To prevent multiple enqueuing
  @@index([status, createdAt])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CalendarConnection {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String    // "google"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

